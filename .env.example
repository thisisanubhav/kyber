NODE_ENV=development
METRICS_TOKEN=
POSTGRES_DB=kyber
POSTGRES_USER=kyber
POSTGRES_PASSWORD=kyber_local_only
DATABASE_URL=postgres://kyber:kyber_local_only@postgres:5432/kyber
DATABASE_SSL=false
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=storage
MINIO_PORT=8333
MINIO_PUBLIC_PORT=9000
S3_SECURE=false
MINIO_ACCESS_KEY=kyber_local
MINIO_SECRET_KEY=kyber_local_secret
MINIO_BUCKET=kyber-private
STORAGE_DRIVER=s3
LOCAL_UPLOAD_DIR=.data/uploads
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
MAIL_FROM_AUTH=Kyber Local <no-reply@joinkyber.local>
MAIL_FROM_CAREERS=Kyber Careers <careers@joinkyber.local>
REQUIRE_EMAIL_VERIFICATION=false
APP_ORIGIN=http://localhost:4174
WEBSITE_ORIGIN=http://localhost:4173
API_ORIGIN=http://localhost:4175
TOKEN_PEPPER=replace-with-a-long-random-secret-before-deploying
KYBER_SEED_REGISTRATION_CODE=KYBER-LOCAL-2026
CLAMAV_ENABLED=true
TRUSTED_PROXIES=
RUN_MIGRATIONS_ON_START=true
