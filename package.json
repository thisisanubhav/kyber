{
  "name": "kyber-local",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["website", "app", "backend"],
  "scripts": {
    "dev:website": "npm run dev --workspace website",
    "dev:app": "npm run dev --workspace app",
    "dev:backend": "npm run dev --workspace backend",
    "dev:worker": "npm run worker --workspace backend",
    "migrate": "npm run migrate --workspace backend",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces && node --test scripts/*.test.mjs",
    "test:integration": "npm run test:integration --workspace backend",
    "load:smoke": "node scripts/load-smoke.mjs",
    "backup:verify": "bash scripts/verify-backup-restore.sh",
    "deploy:preflight": "node scripts/deployment-preflight.mjs",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "sbom": "npm sbom --sbom-format spdx"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  }
}
