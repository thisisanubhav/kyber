NODE_ENV=production
KYBER_BACKEND_IMAGE=registry.example/kyber-backend@sha256:replace-with-image-digest
KYBER_WEBSITE_IMAGE=registry.example/kyber-website@sha256:replace-with-image-digest
KYBER_APP_IMAGE=registry.example/kyber-app@sha256:replace-with-image-digest
PORT=4175
LOG_LEVEL=info
METRICS_TOKEN=replace-with-a-distinct-random-secret-at-least-32-characters

DATABASE_URL=postgres://kyber:replace-me@database.internal:5432/kyber
DATABASE_SSL=true
REDIS_URL=rediss://default:replace-me@redis.internal:6380/0

STORAGE_DRIVER=s3
MINIO_ENDPOINT=storage.internal
MINIO_PUBLIC_ENDPOINT=uploads-staging.joinkyber.com
MINIO_PORT=443
MINIO_PUBLIC_PORT=443
S3_SECURE=true
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-with-a-real-storage-secret
MINIO_BUCKET=kyber-staging-private

CLAMAV_ENABLED=true
CLAMAV_HOST=clamav.internal
CLAMAV_PORT=3310

SMTP_HOST=smtp.provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
MAIL_FROM_AUTH=Kyber Staging <no-reply@staging.joinkyber.com>
MAIL_FROM_CAREERS=Kyber Careers Staging <careers@staging.joinkyber.com>
REQUIRE_EMAIL_VERIFICATION=true

APP_ORIGIN=https://app-staging.joinkyber.com
WEBSITE_ORIGIN=https://staging.joinkyber.com
API_ORIGIN=https://api-staging.joinkyber.com
TOKEN_PEPPER=replace-with-a-random-secret-at-least-32-characters
TRUSTED_PROXIES=10.0.0.0/8
RUN_MIGRATIONS_ON_START=false
